# 运维敏感值模板
#
# 本仓库是公开仓库。运维文档（AGENTS.md、docs/ai/context/）中一律用 ${变量名} 占位，
# 实际值只写在 deploy/ops.env —— 该文件已被 .gitignore 排除，不会进入 git 历史。
#
# 用法：
#   cp deploy/ops.env.example deploy/ops.env
#   然后填入真实值。需要在 shell 中展开时：set -a; . deploy/ops.env; set +a
#
# GitHub Actions 中的对应值走 repository secrets（Settings → Secrets and variables → Actions），
# 不要写进 workflow 文件，也不要写进本文件之外的任何被跟踪文件。

# 生产 VPS 的公网地址
OPS_VPS_HOST=

# 部署用 SSH 账号与端口（与 UFW 放行端口保持一致）
OPS_VPS_USER=
OPS_VPS_PORT=

# 应用部署根目录
OPS_DEPLOY_DIR=

# Cloudflare Tunnel ID
# 注意：当前生产使用的 Tunnel ID 在仓库转为规范化管理之前已随文档公开，
# 应视为已泄露。Tunnel ID 本身不是凭证（建连需要 credentials 文件），
# 但建议轮换一次。轮换后把新值填在这里，不要再写进任何被跟踪文件。
OPS_TUNNEL_ID=

# Cloudflare R2 异地备份桶名
OPS_R2_BUCKET=

# 上游账号凭证加密密钥的宿主机文件路径（AES-256-GCM）
# 该文件本身绝不能进仓库；丢失则全部上游账号凭证不可解密。
ACCOUNT_CREDENTIALS_ENCRYPTION_KEY_HOST_FILE=

# 上游中转站地址（供应商信息，公开会暴露采购来源）
OPS_UPSTREAM_GPT028_HOST=

# 本机部署密钥文件名（不是 id_* 命名，按机器命名）
OPS_SSH_KEY_FILE=
