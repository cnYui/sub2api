# 复制为 deploy/.env.openai-billing-candidate.local 后，仅在本机填入候选环境密码。
# 该文件中的值均为无效示例，禁止写入 API Key、OAuth 凭据或公网数据库密码。

BILLING_OUTER_IMAGE=sub2api-openai-billing-outer:local
BILLING_INNER_IMAGE=sub2api-openai-billing-inner:local

OUTER_POSTGRES_USER=sub2api
OUTER_POSTGRES_PASSWORD=change-me-outer-candidate-only
OUTER_POSTGRES_DB=sub2api
OUTER_REDIS_PASSWORD=

INNER_POSTGRES_USER=sub2api
INNER_POSTGRES_PASSWORD=change-me-inner-candidate-only
INNER_POSTGRES_DB=sub2api
INNER_REDIS_PASSWORD=

TZ=Asia/Tokyo
